APP_NAME="Aksara Kampus"
APP_ENV=production
APP_KEY=base64:GANTI_DENGAN_HASIL_php_artisan_key_generate_show
APP_DEBUG=false
APP_URL=https://api.NAMADOMAIN.infinityfreeapp.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

ADMIN_API_TOKEN=GANTI_DENGAN_TOKEN_RAHASIA_PRODUKSI

FRONTEND_URL=https://NAMADOMAIN.infinityfreeapp.com

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Database (MySQL InfinityFree) ─────────────────────────────────
# Ambil nilai ini dari Control Panel InfinityFree > MySQL Databases
DB_CONNECTION=mysql
DB_HOST=sqlXXX.infinityfree.com
DB_PORT=3306
DB_DATABASE=if0_XXXXXXXX_aksara
DB_USERNAME=if0_XXXXXXXX
DB_PASSWORD=PASSWORD_DATABASE_DARI_PANEL

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.NAMADOMAIN.infinityfreeapp.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@aksarakampus.com"
MAIL_FROM_NAME="Aksara Kampus"
